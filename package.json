{
  "name": "nutrimurt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:test:up": "docker compose -f test/docker-compose.yml up -d --wait",
    "db:test:down": "docker compose -f test/docker-compose.yml down"
  },
  "dependencies": {
    "@clerk/localizations": "4.15.3",
    "@clerk/nextjs": "7.7.6",
    "@neondatabase/serverless": "1.1.0",
    "@react-pdf/renderer": "4.6.1",
    "drizzle-orm": "0.45.2",
    "next": "15.5.23",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
